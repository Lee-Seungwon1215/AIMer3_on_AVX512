# SPDX-License-Identifier: MIT

PAPER_RUNS ?= 7
PAPER_E2E_SAMPLES ?= 50
PAPER_E2E_WARMUP ?= 10
PAPER_KERNEL_SAMPLES ?= 75
PAPER_KERNEL_INNER ?= 32
PAPER_KERNEL_WARMUP ?= 10
PAPER_CORE ?=
PAPER_RESULT_DIR ?=
PAPER_VERIFY ?= 1
PAPER_REBUILD ?= 1
PAPER_KERNEL_RUNS ?= 15
PAPER_KERNEL_TARGET_CYCLES ?= 2800000
PAPER_KERNEL_RESULT_DIR ?=
PAPER_KERNEL_STRICT_ENV ?= 1

.PHONY: bench-paper bench-kernel-paper bench-kernel-paper-isolated

bench-paper:
	RUNS="$(PAPER_RUNS)" E2E_SAMPLES="$(PAPER_E2E_SAMPLES)" \
	E2E_WARMUP="$(PAPER_E2E_WARMUP)" KERNEL_SAMPLES="$(PAPER_KERNEL_SAMPLES)" \
	KERNEL_INNER="$(PAPER_KERNEL_INNER)" KERNEL_WARMUP="$(PAPER_KERNEL_WARMUP)" \
	CORE="$(PAPER_CORE)" RESULT_DIR="$(PAPER_RESULT_DIR)" \
	VERIFY="$(PAPER_VERIFY)" REBUILD="$(PAPER_REBUILD)" \
	CFLAGS="$(CFLAGS)" ./benchmarks/run_paper.sh

bench-kernel-paper:
	RUNS="$(PAPER_KERNEL_RUNS)" KERNEL_SAMPLES="$(PAPER_KERNEL_SAMPLES)" \
	KERNEL_WARMUP="$(PAPER_KERNEL_WARMUP)" \
	TARGET_BATCH_CYCLES="$(PAPER_KERNEL_TARGET_CYCLES)" \
	CORE="$(PAPER_CORE)" RESULT_DIR="$(PAPER_KERNEL_RESULT_DIR)" \
	VERIFY="$(PAPER_VERIFY)" REBUILD="$(PAPER_REBUILD)" \
	STRICT_ENV="$(PAPER_KERNEL_STRICT_ENV)" CFLAGS="$(CFLAGS)" \
	./benchmarks/run_kernel_paper.sh

bench-kernel-paper-isolated:
	sudo ./benchmarks/run_kernel_paper_isolated.sh
