# SPDX-License-Identifier: MIT
# Isolated correctness build: AIM3-128f PCLMUL/AVX2 field + scalar SHAKE/MPC.

CC       ?= cc
CPPFLAGS ?=
CFLAGS   ?= -O3 -Wall -Wextra -fomit-frame-pointer -std=c11
LDFLAGS  ?=
LDLIBS   ?=

BUILD     := build/gf-pclmul
SRC_ROOT  := src
AIMER_DIR := $(SRC_ROOT)/sig/aimer/avx512/aimer-128f
INCLUDES  := -I$(AIMER_DIR) -I$(SRC_ROOT)
GF_FLAGS  := -mavx2 -mpclmul -mbmi2 -mpopcnt -maes

CORE_NAMES := aim3.c hash.c sign.c tree.c
CORE_OBJS  := $(addprefix $(BUILD)/aimer/, $(CORE_NAMES:.c=.o))
COMMON_OBJS := \
  $(BUILD)/common/aes.o \
  $(BUILD)/common/fips202.o \
  $(BUILD)/common/rng.o
FIELD_OBJ := $(BUILD)/aimer/avx512_field128.o
KAT_BIN   := $(BUILD)/PQCgenKAT_sign

.PHONY: all gf-kat clean

all: $(KAT_BIN)

$(BUILD)/aimer/%.o: $(AIMER_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -DPARAMS=128f $(CFLAGS) \
	      -MMD -MP -c $< -o $@

$(FIELD_OBJ): $(SRC_ROOT)/oqs/avx512_field128.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -DPARAMS=128f $(GF_FLAGS) $(CFLAGS) \
	      -MMD -MP -c $< -o $@

$(BUILD)/common/%.o: $(SRC_ROOT)/common/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -I$(SRC_ROOT) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/PQCgenKAT_sign.o: tests/PQCgenKAT_sign.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -DPARAMS=128f $(CFLAGS) \
	      -MMD -MP -c $< -o $@

$(KAT_BIN): $(BUILD)/PQCgenKAT_sign.o $(CORE_OBJS) \
            $(FIELD_OBJ) $(COMMON_OBJS)
	$(CC) $(LDFLAGS) $^ $(LDLIBS) -o $@

gf-kat: $(KAT_BIN)
	@cd $(BUILD) && ./PQCgenKAT_sign >/dev/null
	@if cmp -s KAT/aimer-128f/PQCsignKAT_48.rsp \
	             $(BUILD)/PQCsignKAT_48.rsp; then \
		echo "[PASS] aimer-128f PCLMUL field + scalar SHAKE/MPC official KAT"; \
	else \
		echo "[FAIL] aimer-128f PCLMUL field + scalar SHAKE/MPC official KAT"; \
		exit 1; \
	fi

clean:
	rm -rf $(BUILD)

DEPS := $(CORE_OBJS:.o=.d) $(FIELD_OBJ:.o=.d) \
        $(COMMON_OBJS:.o=.d) $(BUILD)/PQCgenKAT_sign.d
-include $(DEPS)
