	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -include $(SRC_ROOT)/oqs/kat_compat_192s.h \
	      $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/tests/256f/PQCgenKAT_sign.o: tests/PQCgenKAT_sign.c \
    $(SRC_ROOT)/oqs/kat_compat_256f.h
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -include $(SRC_ROOT)/oqs/kat_compat_256f.h \
	      $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/tests/256s/PQCgenKAT_sign.o: tests/PQCgenKAT_sign.c \
    $(SRC_ROOT)/oqs/kat_compat_256s.h
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -include $(SRC_ROOT)/oqs/kat_compat_256s.h \
	      $(CFLAGS) -MMD -MP -c $< -o $@

$(KAT_128F_BIN): $(BUILD)/tests/128f/PQCgenKAT_sign.o $(OQS_LIB)
	$(CC) $(LDFLAGS) $< $(OQS_LIB) $(LDLIBS) -o $@

$(KAT_128S_BIN): $(BUILD)/tests/128s/PQCgenKAT_sign.o $(OQS_LIB)
	$(CC) $(LDFLAGS) $< $(OQS_LIB) $(LDLIBS) -o $@

$(KAT_192F_BIN): $(BUILD)/tests/192f/PQCgenKAT_sign.o $(OQS_LIB)
	$(CC) $(LDFLAGS) $< $(OQS_LIB) $(LDLIBS) -o $@

$(KAT_192S_BIN): $(BUILD)/tests/192s/PQCgenKAT_sign.o $(OQS_LIB)
	$(CC) $(LDFLAGS) $< $(OQS_LIB) $(LDLIBS) -o $@

$(KAT_256F_BIN): $(BUILD)/tests/256f/PQCgenKAT_sign.o $(OQS_LIB)
	$(CC) $(LDFLAGS) $< $(OQS_LIB) $(LDLIBS) -o $@

$(KAT_256S_BIN): $(BUILD)/tests/256s/PQCgenKAT_sign.o $(OQS_LIB)
	$(CC) $(LDFLAGS) $< $(OQS_LIB) $(LDLIBS) -o $@

$(REGISTRY_BIN): tests/test_oqs_sig_registry.c $(OQS_LIB)
	@mkdir -p build/liboqs/tests
	$(CC) $(CPPFLAGS) $(INCLUDES) $(CFLAGS) $(LDFLAGS) \
	      $< $(OQS_LIB) $(LDLIBS) -o $@

$(GF_EQ_BIN): tests/test_gf_equivalence.c $(OQS_LIB)
	@mkdir -p build/liboqs/tests
	$(CC) $(CPPFLAGS) $(INCLUDES) $(CFLAGS) $(LDFLAGS) \
	      $< $(OQS_LIB) $(LDLIBS) -o $@

$(BENCH_BIN): benchmarks/bench_full.c $(OQS_LIB)
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) $(CFLAGS) $(LDFLAGS) \
	      $< $(OQS_LIB) $(LDLIBS) -lm -o $@

oqs-bench: $(BENCH_BIN)

oqs-test: $(REGISTRY_BIN) $(GF_EQ_BIN)
	@$(GF_EQ_BIN)
	@AIMER_V3_IMPL=ref $(REGISTRY_BIN)
	@AIMER_V3_IMPL=avx2 $(REGISTRY_BIN)
	@AIMER_V3_IMPL=avx512 $(REGISTRY_BIN)
	@env -u AIMER_V3_IMPL $(REGISTRY_BIN)

oqs-kat-128f: $(KAT_128F_BIN)
	@cd $(BUILD)/tests/128f && AIMER_V3_IMPL=ref ./kat_sig >/dev/null
	@if cmp -s KAT/aimer-128f/PQCsignKAT_48.rsp \
	             $(BUILD)/tests/128f/PQCsignKAT_48.rsp; then \
		echo "[PASS] AIMER-v3-128f OQS_SIG ref official KAT (100 vectors)"; \
	else \
		echo "[FAIL] AIMER-v3-128f OQS_SIG ref official KAT"; exit 1; \
	fi
	@cd $(BUILD)/tests/128f && AIMER_V3_IMPL=avx2 ./kat_sig >/dev/null
	@if cmp -s KAT/aimer-128f/PQCsignKAT_48.rsp \
	             $(BUILD)/tests/128f/PQCsignKAT_48.rsp; then \
		echo "[PASS] AIMER-v3-128f OQS_SIG AVX2 official KAT (100 vectors)"; \
	else \
		echo "[FAIL] AIMER-v3-128f OQS_SIG AVX2 official KAT"; exit 1; \
	fi
	@cd $(BUILD)/tests/128f && AIMER_V3_IMPL=avx512 ./kat_sig >/dev/null
	@if cmp -s KAT/aimer-128f/PQCsignKAT_48.rsp \
	             $(BUILD)/tests/128f/PQCsignKAT_48.rsp; then \
		echo "[PASS] AIMER-v3-128f OQS_SIG AVX-512 official KAT (100 vectors)"; \
	else \
		echo "[FAIL] AIMER-v3-128f OQS_SIG AVX-512 official KAT"; exit 1; \
	fi

