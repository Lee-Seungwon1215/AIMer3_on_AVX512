oqs-kat: oqs-kat-128f oqs-kat-128s oqs-kat-192f oqs-kat-192s oqs-kat-256f oqs-kat-256s
oqs-check: oqs-kat oqs-test

clean:
	rm -rf $(BUILD) $(OQS_LIB)

DEPS := $(OQS_OBJS:.o=.d) \
        $(BUILD)/tests/128f/PQCgenKAT_sign.d \
        $(BUILD)/tests/128s/PQCgenKAT_sign.d \
        $(BUILD)/tests/192f/PQCgenKAT_sign.d \
        $(BUILD)/tests/192s/PQCgenKAT_sign.d \
        $(BUILD)/tests/256f/PQCgenKAT_sign.d \
        $(BUILD)/tests/256s/PQCgenKAT_sign.d
-include $(DEPS)
include benchmarks/Makefile.kernels.inc
include benchmarks/Makefile.causes.inc
