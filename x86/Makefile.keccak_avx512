# SPDX-License-Identifier: MIT
# Isolated correctness build: AIM3 scalar field/MPC + AVX-512VL SHAKE.

CC       ?= cc
CPPFLAGS ?=
CFLAGS   ?= -O3 -Wall -Wextra -fomit-frame-pointer -std=c11
LDFLAGS  ?=
LDLIBS   ?=

BUILD     := build/keccak-avx512
SRC_ROOT  := src
COMMON_ROOT := ../common/src
KAT_ROOT := ../common/KAT
AIMER_DIR := $(SRC_ROOT)/sig/aimer/avx512/aimer-128f

INCLUDES := -I$(SRC_ROOT)/oqs/avx512_override \
            -I$(AIMER_DIR) -I$(SRC_ROOT) -I$(COMMON_ROOT)

CORE_NAMES := aim3.c field_common.c hash.c sign.c tree.c field128.c
CORE_OBJS  := $(addprefix $(BUILD)/aimer/, $(CORE_NAMES:.c=.o))
COMMON_OBJS := $(BUILD)/common/aes.o $(BUILD)/common/rng.o
AVX512_OBJS := \
  $(BUILD)/avx512/avx512_shake.o \
  $(BUILD)/avx512/KeccakP-1600-AVX512VL.o \
  $(BUILD)/avx512/SHA3-AVX512VL.o
KAT_BIN := $(BUILD)/PQCgenKAT_sign

.PHONY: all keccak-kat clean

all: $(KAT_BIN)

$(BUILD)/aimer/%.o: $(AIMER_DIR)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -DPARAMS=128f $(CFLAGS) \
	      -MMD -MP -c $< -o $@

$(BUILD)/common/%.o: $(COMMON_ROOT)/common/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -I$(SRC_ROOT) -I$(COMMON_ROOT) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/avx512/avx512_shake.o: $(SRC_ROOT)/oqs/avx512_shake.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -I$(SRC_ROOT) -I$(COMMON_ROOT) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/avx512/%.o: $(SRC_ROOT)/oqs/avx512vl_low/%.S
	@mkdir -p $(dir $@)
	$(CC) -Wa,--noexecstack -c $< -o $@

$(BUILD)/PQCgenKAT_sign.o: tests/PQCgenKAT_sign.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -I$(AIMER_DIR) -I$(SRC_ROOT) -I$(COMMON_ROOT) -DPARAMS=128f \
	      $(CFLAGS) -MMD -MP -c $< -o $@

$(KAT_BIN): $(BUILD)/PQCgenKAT_sign.o $(CORE_OBJS) \
            $(COMMON_OBJS) $(AVX512_OBJS)
	$(CC) $(LDFLAGS) $^ $(LDLIBS) -o $@

keccak-kat: $(KAT_BIN)
	@cd $(BUILD) && ./PQCgenKAT_sign >/dev/null
	@if cmp -s $(KAT_ROOT)/aimer-128f/PQCsignKAT_48.rsp \
	             $(BUILD)/PQCsignKAT_48.rsp; then \
		echo "[PASS] aimer-128f scalar GF/MPC + AVX-512VL SHAKE official KAT"; \
	else \
		echo "[FAIL] aimer-128f scalar GF/MPC + AVX-512VL SHAKE official KAT"; \
		exit 1; \
	fi

clean:
	rm -rf $(BUILD)

DEPS := $(CORE_OBJS:.o=.d) $(COMMON_OBJS:.o=.d) \
        $(BUILD)/avx512/avx512_shake.d $(BUILD)/PQCgenKAT_sign.d
-include $(DEPS)
