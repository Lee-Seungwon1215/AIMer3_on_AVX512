# SPDX-License-Identifier: MIT
# AIM3-128f isolated correctness build with AVX-512 SHAKE and MPC batching.

CC       ?= cc
CPPFLAGS ?=
CFLAGS   ?= -O3 -Wall -Wextra -fomit-frame-pointer -std=c11
LDFLAGS  ?=
LDLIBS   ?=

BUILD     := build/mpc-avx512
SRC_ROOT  := src
COMMON_ROOT := ../common/src
KAT_ROOT := ../common/KAT
AIMER_DIR := $(SRC_ROOT)/sig/aimer/avx512/aimer-128f
INCLUDES  := -I$(SRC_ROOT)/oqs/avx512_override \
             -I$(AIMER_DIR) -I$(SRC_ROOT) -I$(COMMON_ROOT)
AVX512_FLAGS := -mavx2 -mpclmul -mavx512f -mavx512vl -mavx512bw \
                -mavx512dq -mvpclmulqdq -mbmi2 -mpopcnt -maes

CORE_OBJS := \
  $(BUILD)/aimer/aim3.o \
  $(BUILD)/aimer/hash.o \
  $(BUILD)/aimer/tree.o \
  $(BUILD)/aimer/avx512_sign_128f.o \
  $(BUILD)/aimer/avx512_field128.o \
  $(BUILD)/aimer/avx512_field128_batch.o \
  $(BUILD)/aimer/avx512_mpc.o

COMMON_OBJS := $(BUILD)/common/aes.o $(BUILD)/common/rng.o
SHAKE_OBJS := \
  $(BUILD)/shake/avx512_shake.o \
  $(BUILD)/shake/KeccakP-1600-AVX512VL.o \
  $(BUILD)/shake/SHA3-AVX512VL.o
KAT_BIN := $(BUILD)/PQCgenKAT_sign

.PHONY: all mpc-kat clean

all: $(KAT_BIN)

$(BUILD)/aimer/aim3.o: $(AIMER_DIR)/aim3.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -DPARAMS=128f $(AVX512_FLAGS) \
	      $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/aimer/hash.o: $(AIMER_DIR)/hash.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -DPARAMS=128f $(AVX512_FLAGS) \
	      $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/aimer/tree.o: $(AIMER_DIR)/tree.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -DPARAMS=128f $(AVX512_FLAGS) \
	      $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/aimer/%.o: $(SRC_ROOT)/oqs/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) $(INCLUDES) -DPARAMS=128f $(AVX512_FLAGS) \
	      $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/common/%.o: $(COMMON_ROOT)/common/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -I$(SRC_ROOT) -I$(COMMON_ROOT) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/shake/avx512_shake.o: $(SRC_ROOT)/oqs/avx512_shake.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -I$(SRC_ROOT) -I$(COMMON_ROOT) $(CFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/shake/%.o: $(SRC_ROOT)/oqs/avx512vl_low/%.S
	@mkdir -p $(dir $@)
	$(CC) -Wa,--noexecstack -c $< -o $@

$(BUILD)/PQCgenKAT_sign.o: tests/PQCgenKAT_sign.c
	@mkdir -p $(dir $@)
	$(CC) $(CPPFLAGS) -I$(AIMER_DIR) -I$(SRC_ROOT) -I$(COMMON_ROOT) -DPARAMS=128f \
	      $(CFLAGS) -MMD -MP -c $< -o $@

$(KAT_BIN): $(BUILD)/PQCgenKAT_sign.o $(CORE_OBJS) \
            $(COMMON_OBJS) $(SHAKE_OBJS)
	$(CC) $(LDFLAGS) $^ $(LDLIBS) -o $@

mpc-kat: $(KAT_BIN)
	@cd $(BUILD) && ./PQCgenKAT_sign >/dev/null
	@if cmp -s $(KAT_ROOT)/aimer-128f/PQCsignKAT_48.rsp \
	             $(BUILD)/PQCsignKAT_48.rsp; then \
		echo "[PASS] aimer-128f AVX-512 SHAKE/GF/MPC official KAT"; \
	else \
		echo "[FAIL] aimer-128f AVX-512 SHAKE/GF/MPC official KAT"; exit 1; \
	fi

clean:
	rm -rf $(BUILD)

DEPS := $(CORE_OBJS:.o=.d) $(COMMON_OBJS:.o=.d) \
        $(BUILD)/shake/avx512_shake.d $(BUILD)/PQCgenKAT_sign.d
-include $(DEPS)
